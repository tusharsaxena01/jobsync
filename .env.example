# Note: Copy these variables in your .env file

# DATABASE_URL=file:./dev.db

# If you are running it on a remote server/homelab, you must update timezone otherwise activities times may shift
TZ=America/Edmonton

# For homelab server, change the following to your server ip ex: http://192.168.x.x:3737
NEXTAUTH_URL=http://localhost:3737

# Required when the app is not served from localhost (homelab ip, reverse proxy)
AUTH_TRUST_HOST=true

# AUTH_SECRET is auto-generated by deploy.sh and docker-entrypoint.sh
# To set manually, uncomment and provide your own value:
# AUTH_SECRET=

# ENCRYPTION_KEY is used to encrypt stored API keys (OpenAI, DeepSeek, RapidAPI)
# Must be stable across restarts — changing it will make all stored API keys unrecoverable
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

OPENAI_API_KEY=your-openai-api-key-here

# DeepSeek API Key - get from https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Gemini API Key - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key - get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# For homelab server, if you ollama is running on server, change the following to your ollamma ip ex: http://192.168.x.x:12345
OLLAMA_BASE_URL=http://host.docker.internal:11435

# AI Configuration
# The system uses LLM-based semantic extraction for intelligent, context-aware skill matching
# No configuration needed - semantic extraction is the default

RAPIDAPI_KEY=your-rapidapi-key-here

# Enables the MCP server in production (default: on in dev, off in prod)
MCP_ENABLED=true

# ==========================================
# Database Backup & Cron Configuration
# ==========================================
# Automated backup cron schedule (default: 0 2 * * * = daily at 2:00 AM)
DB_BACKUP_CRON=0 2 * * *
DB_BACKUP_ENABLED=true

# Gmail SMTP Settings
# To get a Gmail App Password:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password for "Mail" and copy the 16-character code below
GMAIL_USER=tusharsaxena786786@gmail.dom
GMAIL_APP_PASSWORD=mtzi akdq ialg vkus
BACKUP_EMAIL_TO=tushar.personal.786@gmail.com
# Optional SMTP overrides (defaults to Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Google Drive Backup Settings
# Uploads database backup named: job_sync_db_<date>_<time>.db
#
# Option A: Service Account (Recommended for servers/homelab)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account.json
# Or provide service account details via env vars:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Or provide the full JSON string:
# GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Option B: OAuth2 Refresh Token
# GOOGLE_DRIVE_CLIENT_ID=your-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
#
# Optional: Target Google Drive Folder ID (if omitted, uploads to root)
# GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
